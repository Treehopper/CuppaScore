{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "featureSchema": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sellers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "roaster",
              "roaster-cafe",
              "shop",
              "cafe",
              "supermarket"
            ]
          },
          "addresses": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "street": {
                  "type": "string"
                },
                "zip": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                },
                "lat": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lng": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "street",
                "zip"
              ]
            }
          },
          "webshop": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "shipsTo": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          },
          "pickup": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "type"
        ]
      }
    },
    "coffees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "sellerIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roaster": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "default": {},
            "type": "object",
            "properties": {
              "country": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "region": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "process": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "washed",
                  "natural",
                  "honey",
                  "anaerobic",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "varietals": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roastLevel": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "roastFor": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "filter",
                "espresso",
                "omni"
              ]
            }
          },
          "isBlend": {
            "default": false,
            "type": "boolean"
          },
          "decaf": {
            "default": false,
            "type": "boolean"
          },
          "tastingNotes": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "flavourVector": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "fruity",
                "floral",
                "chocolate",
                "nutty",
                "caramel",
                "spice",
                "earthy",
                "citrus"
              ]
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "sensory": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "acidity",
                "sweetness",
                "body",
                "bitterness"
              ]
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "priceEurPerKg": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "sizesG": {
            "default": [],
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "barcode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{8,14}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "available": {
            "default": true,
            "type": "boolean"
          },
          "lastSeen": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "default": "manual",
            "type": "string"
          }
        },
        "required": [
          "id",
          "sellerIds",
          "roaster",
          "name"
        ]
      }
    }
  },
  "required": [
    "version",
    "generatedAt",
    "featureSchema",
    "sellers",
    "coffees"
  ]
}
