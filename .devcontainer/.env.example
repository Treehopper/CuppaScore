# Copy to .devcontainer/.env (git-ignored). All values are optional.

# Claude auth — pick one. Without either, run `.devcontainer/sandbox.sh shell` once
# and log in with `claude` (credentials persist in the claude-config volume).
# A long-lived OAuth token for a Claude subscription comes from `claude setup-token` on the host.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Git identity for commits made inside the container
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# Fine-grained GitHub token (this repo only) if Claude should push / open PRs.
# Leave unset to keep all commits local for review.
# GH_TOKEN=

